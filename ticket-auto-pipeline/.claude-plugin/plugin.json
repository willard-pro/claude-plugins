{
  "name": "ticket-auto-pipeline",
  "version": "0.5.0",
  "description": "Fully autonomous Linear ticket pipeline — appraise, implement, verify, and merge with zero user input. Includes 20+ slash commands, state-machine-driven flow control, safety gates, and retrospective analysis.",
  "author": {
    "name": "John Willard"
  },
  "repository": "https://github.com/willard-pro/claude-plugins",
  "license": "UNLICENSED",
  "keywords": [
    "linear",
    "ticket",
    "pipeline",
    "automation",
    "project-management"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'mkdir -p ~/.claude/skills/lib && cp \"${CLAUDE_PLUGIN_ROOT}/lib/\"*.sh ~/.claude/skills/lib/'",
            "timeout": 10,
            "statusMessage": "Syncing ticket-auto-pipeline lib scripts..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/token-tracker-start.sh",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/token-tracker.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
